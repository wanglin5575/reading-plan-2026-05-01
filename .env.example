# Firecrawl 抓取（可选，但强烈建议设置以获得最佳抓取效果）
# 申请：https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Postgres 连接串（Transaction pooler 推荐）
# 例：postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/reading_plan
