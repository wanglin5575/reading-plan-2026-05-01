# Firecrawl 抓取（可选，但强烈建议设置以获得最佳抓取效果）
# 申请：https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase（可选：启用邮箱注册 / 登录后，文章按账号隔离）
# 控制台 → Project Settings → API：Project URL、anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Postgres 连接串（Transaction pooler 推荐）
# 例：postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# 本地演示：库为空时自动插入 1 条待读 + 1 条已读（生产环境请删除本行或改为 0）
SEED_DEMO_ARTICLES=1

# —— 可选：统一 AI（OpenAI 兼容 Chat Completions，仅服务端；勿使用 NEXT_PUBLIC_）——
# 若优先使用 WolfAI：一般只需配置下方三个 WOLF_*（不要在别处再填冲突的 AI_SUMMARY_*，否则 AI_SUMMARY_* 优先）。
# WolfAI 控制台给出的网关通常是 Base URL + Key + 模型名；Base 写到「…/v1」一层即可。
#
# WOLF_BASE_URL=https://你的wolf网关/v1
# WOLF_API_KEY=
# WOLF_MODEL=
#
# 与 WOLF_* 等价别名（二选一即可；同时存在时 AI_SUMMARY_* 优先于 WOLF_*）
# AI_SUMMARY_BASE_URL=
# AI_SUMMARY_API_KEY=
# AI_SUMMARY_MODEL=
#
# 鉴权：bearer（默认）| x-api-key（部分网关）
# AI_SUMMARY_AUTH=bearer
# AI_SUMMARY_MAX_INPUT_CHARS=12000
# AI_SUMMARY_MAX_OUTPUT_TOKENS=800
# AI_SUMMARY_TIMEOUT_MS=45000
# 网关不支持 response_format=json_object 时设为 0
# AI_SUMMARY_JSON_MODE=0
#
# —— 视频 / 图集页：多模态摘要（手动添加文章、书库「刷新文章」时，Firecrawl 会对部分站点抓取首屏截图）——
# 已配置时：同一套 AI_SUMMARY_BASE_URL（或 WOLF_BASE_URL）+ AI_SUMMARY_API_KEY（或 WOLF_API_KEY）下，
# 书库分类/摘要请求会改用「文本 + 首屏截图(data URL)」的多模态 Chat Completions（user 消息为 text 块 + image_url 块）。
# 须使用网关文档中支持视觉的模型名（OpenAI 兼容：gpt-4o、claude-3.5-sonnet 等，以你的供应商为准）。
# AI_SUMMARY_VISION_MODEL=gpt-4o-mini
#
# 未配置 AI_SUMMARY_VISION_MODEL：仍只用文本；若抓取侧有截图，会在 user 提示里说明「仅依据文字」。
#
# 截图 data URL 过长则跳过多模态（避免撑爆请求体）。默认约 40 万字符，上限代码侧还会再卡一道。
# AI_SUMMARY_SCREENSHOT_MAX_CHARS=400000
#
# 云端 AI 缓存（ai_generation_cache）的 enrich 输入 hash 为 v2，含 visionFingerprint（截图内容摘要），
# 避免「纯文本缓存」与「带图缓存」混用同一条目。
#
# 随览（/api/browse/fetch）：Firecrawl 拉取链接后，用 Wolf 对正文做摘要 + 发布时间/作者 + 是否「值得读」；低价值条可在服务端过滤；摘要卡片显示灰色「AI生成」。
# 关闭随览 Wolf 摘要（仍可走下方翻译链）：
# BROWSE_ENRICH_VIA_LLM=0
# 不因「不值得读」而筛掉条目（调试用，默认会筛；筛除列表亦为空）：
# BROWSE_AI_WORTH_FILTER=0
#
# 翻译（随览摘要/标题、摘要降级路径）：默认在已配置上述网关时【优先】走同一 Chat Completions（即 WolfAI）。
# 仅想用免费公开翻译、不走模型时：
# AI_TRANSLATE_VIA_LLM=0
# 翻译单独指定模型（不设则用 AI_SUMMARY_MODEL / WOLF_MODEL）
# AI_TRANSLATE_MODEL=
# AI_TRANSLATE_MAX_TOKENS=1024
# AI_TRANSLATE_TIMEOUT_MS=

# —— 管理后台 Token 美元估算（与 WolfAI 控制台「按量计费」分列对应；单价为美元/千 tokens）——
# 图示参考（default 分组）：输入 $3/1M → 0.003；补全 $15/1M → 0.015。可同时不设，则代码使用此默认分列。
# AI_TOKEN_INPUT_USD_PER_1K=0.003
# AI_TOKEN_COMPLETION_USD_PER_1K=0.015
# 若仅希望对「输入+补全」合计 tokens 使用单一单价（旧行为），可只设此项（不设分项变量）：
# AI_TOKEN_USD_PER_1K=

# —— 管理后台：账号列展示名（可选）——
# JSON：user id → 在「会员与用量」等表格中显示的友好名称（覆盖邮箱/UID）。也可在代码内置少量映射。
# READING_PLAN_ACCOUNT_DISPLAY_LABELS={"7f9410c8-e00e-4993-964f-9fe65fc0a460":"wangsheng"}

# —— 管理后台管理员邮箱（可选）——
# 逗号分隔追加账号；代码内已内置默认管理员 vienna.wwl@gmail.com（Gmail 比对时会忽略 local 中的「.」与「+标签」）。
# ADMIN_EMAILS=other.admin@example.com,second@company.com
# 未设置 SUPABASE_SERVICE_ROLE_KEY 时，会员列表主要依赖 app_user_registry，与管理员身份无关。

# VIP 账号登录（管理员在后台创建的用户名+密码）：会话 Cookie 签名密钥。
# 可不设：将用 SUPABASE_SERVICE_ROLE_KEY 或上方 Postgres 连接串派生（部署已配库时通常可直接登录）。
# 生产环境建议单独设置随机长字符串，与数据库凭据解耦、便于轮换：
# READING_PLAN_VIP_SESSION_SECRET=
