# Firecrawl 抓取（可选，但强烈建议设置以获得最佳抓取效果）
# 申请：https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase（可选：启用邮箱注册 / 登录后，文章按账号隔离）
# 控制台 → Project Settings → API：Project URL、anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Postgres 连接串（Transaction pooler 推荐）
# 例：postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# 本地演示：库为空时自动插入 1 条待读 + 1 条已读（生产环境请删除本行或改为 0）
SEED_DEMO_ARTICLES=1

# —— 可选：AI 摘要（OpenAI 兼容 Chat Completions，仅服务端读取；勿使用 NEXT_PUBLIC_ 前缀）——
# 未配置时仍使用「截取前几句 + 机器翻译」生成约 70 字摘要。
# 国内/自建网关请填完整 Base URL（见下方「wolf」别名）。
# AI_SUMMARY_BASE_URL=https://api.openai.com/v1
# AI_SUMMARY_API_KEY=sk-...
# AI_SUMMARY_MODEL=gpt-4o-mini
# 鉴权：bearer（默认，Authorization: Bearer）| x-api-key（X-API-Key 头，部分企业网关）
# AI_SUMMARY_AUTH=bearer
# AI_SUMMARY_MAX_INPUT_CHARS=12000
# 结构化 JSON（摘要+作者+日期+时长）需要更大输出窗口，默认 800
# AI_SUMMARY_MAX_OUTPUT_TOKENS=800
# AI_SUMMARY_TIMEOUT_MS=45000
# 网关不支持 OpenAI response_format=json_object 时设为 0（仅靠模型自觉输出 JSON，解析失败会整段降级）
# AI_SUMMARY_JSON_MODE=0
# 与 AI_SUMMARY_* 等价别名（便于 wolf / 自建兼容站）
# WOLF_BASE_URL=https://你的网关/v1
# WOLF_API_KEY=
# WOLF_MODEL=
