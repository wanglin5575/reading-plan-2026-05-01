# 复制为 configure-supabase-smtp.env（与脚本同目录），填好后执行：
#   set -a && source scripts/configure-supabase-smtp.env && set +a && ./scripts/configure-supabase-smtp.sh
# configure-supabase-smtp.env 已加入 .gitignore，勿提交。

# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# 项目 Settings → General → Reference ID
PROJECT_REF=

# 邮件服务商 SMTP（示例为 Resend：host smtp.resend.com port 465 user resend pass=API_KEY）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 必须是已在服务商处验证过的发件地址
SMTP_ADMIN_EMAIL=no-reply@your-verified-domain.com
SMTP_SENDER_NAME=阅读计划

# 可选：开启后新用户注册不需要收确认邮件（仅开发用，生产勿开）
# MAILER_AUTOCONFIRM=false
